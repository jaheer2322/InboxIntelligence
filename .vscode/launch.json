{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Streamlit App",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": [
        "run",
        "${workspaceFolder}/frontend/app.py",
        "--server.port",
        "8502"
      ],
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "InboxIntelligence 2.0",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": [
        "run",
        "${workspaceFolder}/frontend/inbox_intelligence_ui.py",
        "--server.port",
        "8502"
      ],
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
